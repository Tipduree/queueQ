# Neon PostgreSQL — get connection strings from https://console.neon.tech
# Pooled connection (use for the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection (use for Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

PORT=3001
# Comma-separated origins for CORS (production + local dev)
FRONTEND_URL="http://localhost:3000,https://frontend-two-phi-66.vercel.app"

# Admin API (used by frontend BFF — Bearer token)
ADMIN_API_KEY="change-me-long-random-string"

# LINE Messaging API (admin confirm/cancel push from backend)
LINE_CHANNEL_ACCESS_TOKEN=""

# LINE webhook signature verification
LINE_CHANNEL_SECRET=""
