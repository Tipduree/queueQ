generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Service {
  id           String        @id @default(cuid())
  slug         String        @unique
  nameKey      String        @map("name_key")
  durationMin  Int           @map("duration_min")
  price        Int
  categoryKey  String        @map("category_key")
  tint1        String
  tint2        String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  bookingItems BookingItem[]

  @@map("services")
}

model Booking {
  id            String        @id @default(cuid())
  queueNumber   String        @unique @map("queue_number")
  guestName     String        @map("guest_name")
  guestPhone    String        @map("guest_phone")
  guestCount    Int           @default(1) @map("guest_count")
  notes         String?
  bookingDate   DateTime      @map("booking_date") @db.Date
  timeSlot      String        @map("time_slot")
  status        BookingStatus @default(PENDING)
  totalPrice    Int           @map("total_price")
  totalDuration Int           @map("total_duration")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  items         BookingItem[]

  @@index([bookingDate, timeSlot])
  @@map("bookings")
}

model BookingItem {
  bookingId String  @map("booking_id")
  serviceId String  @map("service_id")
  price     Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([bookingId, serviceId])
  @@map("booking_items")
}
